; EmuV0 on AROS One: version, Shell launch, exit code, a Workbench-style
; launch of an ABIv0 binary. Programs are started with Run so the script
; goes on; the host takes a screenshot of each.
Failat 30
Echo >RESULTS:EV2-contract.txt "run EV2 contract"
Version C:EmuV0 FULL >>RESULTS:EV2-contract.txt
Echo "== no argument" >>RESULTS:EV2-contract.txt
C:EmuV0 >>RESULTS:EV2-contract.txt
Echo "rc $RC" >>RESULTS:EV2-contract.txt
Echo "== missing program" >>RESULTS:EV2-contract.txt
C:EmuV0 RAM:ev/nonexistent >>RESULTS:EV2-contract.txt
Echo "rc $RC" >>RESULTS:EV2-contract.txt
Echo "== native binary given to EmuV0" >>RESULTS:EV2-contract.txt
Echo "(skipped: may crash the emulator)" >>RESULTS:EV2-contract.txt
Echo "== ABIv0 binary run directly" >>RESULTS:EV2-contract.txt
RAM:ev/ResCode/ResCode >>RESULTS:EV2-contract.txt
Echo "rc $RC" >>RESULTS:EV2-contract.txt
Echo "done" >>RESULTS:EV2-contract.txt
