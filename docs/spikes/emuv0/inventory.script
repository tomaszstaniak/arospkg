; What AROS One already has for ABIv0 programs, before anything is installed.
Failat 30
Echo >RESULTS:EV1-inventory.txt "run EV1 inventory"
Version >>RESULTS:EV1-inventory.txt
Echo "== C:EmuV0#?" >>RESULTS:EV1-inventory.txt
List C: PAT=EmuV0#? >>RESULTS:EV1-inventory.txt
Echo "== assigns" >>RESULTS:EV1-inventory.txt
Assign >>RESULTS:EV1-inventory.txt
Echo "== ENVARC:SYS/Packages" >>RESULTS:EV1-inventory.txt
List ENVARC:SYS/Packages >>RESULTS:EV1-inventory.txt
Type ENVARC:SYS/Packages/#? >>RESULTS:EV1-inventory.txt
Echo "== EmuV0: tree" >>RESULTS:EV1-inventory.txt
List EmuV0: ALL LFORMAT="%p%n %l" >>RESULTS:EV1-inventory.txt
Echo "== SYS:Tools" >>RESULTS:EV1-inventory.txt
List SYS:Tools >>RESULTS:EV1-inventory.txt
Echo "== Startup-Sequence lines about packages" >>RESULTS:EV1-inventory.txt
Search S:Startup-Sequence Package >>RESULTS:EV1-inventory.txt
Search S:Startup-Sequence LIBSV0 >>RESULTS:EV1-inventory.txt
Echo "== S:Package-Startup" >>RESULTS:EV1-inventory.txt
Type S:Package-Startup >>RESULTS:EV1-inventory.txt
Echo "== EmuV0-pc version" >>RESULTS:EV1-inventory.txt
Version C:EmuV0-pc FULL >>RESULTS:EV1-inventory.txt
Echo "== LIBSV0: count" >>RESULTS:EV1-inventory.txt
List LIBSV0: PAT=#?.library LFORMAT="%n %l" >>RESULTS:EV1-inventory.txt
Echo "done" >>RESULTS:EV1-inventory.txt
