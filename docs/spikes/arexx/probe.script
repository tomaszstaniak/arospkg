; ARexx probe on a pool v11 slot. Run id in the first line of every file.
Failat 30
Echo >RESULTS:probe-P1-env.txt "run P1"
Version >>RESULTS:probe-P1-env.txt
List SYS:System/ PAT=#?Rexx#? >>RESULTS:probe-P1-env.txt
List SYS:C/ PAT=R#? >>RESULTS:probe-P1-env.txt
List SYS:Libs/ PAT=#?rexx#? >>RESULTS:probe-P1-env.txt
Status >>RESULTS:probe-P1-env.txt
Echo "rx before start:" >>RESULTS:probe-P1-env.txt
Copy RAM:p/rxprobe RAM:rxprobe
Protect RAM:rxprobe +e
Run >NIL: RAM:rxprobe RESULTS:probe-P1-host.txt
Wait 2
rx RAM:p/probe.rexx P1 >>RESULTS:probe-P1-env.txt
Echo "rc after rx: $RC" >>RESULTS:probe-P1-env.txt
Status >>RESULTS:probe-P1-env.txt
Echo "done" >>RESULTS:probe-P1-env.txt
