diff --git a/src/libpkg/net.c b/src/libpkg/net.c
index 27cbeb9..f259074 100644
--- a/src/libpkg/net.c
+++ b/src/libpkg/net.c
@@ -176,6 +176,17 @@ static int fetch_once(const char *host, const char *path, str *body,
             }
         }
     }
+    {
+        extern int diag_tls_err, diag_sock_errno, diag_recv_zero;
+        char *h = raw.p ? strstr(raw.p, "\r\n\r\n") : NULL;
+        char *cl = raw.p ? strstr(raw.p, "\nContent-Length:") : NULL;
+        if (!cl && raw.p) cl = strstr(raw.p, "\ncontent-length:");
+        printf("DIAG host=%s end_n=%d tls_ret=%d (-0x%04x) sock_errno=%d recv0=%d raw=%lu body=%lu content_length=%ld slow_ms=%d\n",
+               host, (int)n, diag_tls_err, (unsigned)(-diag_tls_err), diag_sock_errno, diag_recv_zero,
+               (unsigned long)raw.len, h ? (unsigned long)(raw.len - (size_t)(h + 4 - raw.p)) : 0UL,
+               (cl && h && cl < h) ? atol(cl + 16) : -1L, slow_ms);
+        diag_tls_err = diag_sock_errno = diag_recv_zero = 0;
+    }
     if (!raw.len) { snprintf(why, 240, "empty response from %s", host); goto out; }
 
     hdr_end = strstr(raw.p, "\r\n\r\n");
diff --git a/src/tls/mbedtls.c b/src/tls/mbedtls.c
index cb09aa3..9d38d4f 100644
--- a/src/tls/mbedtls.c
+++ b/src/tls/mbedtls.c
@@ -35,9 +35,12 @@ static int bio_send(void *ctx, const unsigned char *b, size_t n)
     return r < 0 ? MBEDTLS_ERR_SSL_INTERNAL_ERROR : r;
 }
 
+int diag_tls_err, diag_sock_errno, diag_recv_zero;
 static int bio_recv(void *ctx, unsigned char *b, size_t n)
 {
     int r = recv(((tls *)ctx)->sock, b, (int)n, 0);
+    if (r < 0) diag_sock_errno = Errno();
+    if (r == 0) diag_recv_zero++;
     return r < 0 ? MBEDTLS_ERR_SSL_INTERNAL_ERROR : r;
 }
 
@@ -161,6 +164,7 @@ int tls_read(tls *t, void *b, size_t n)
     }
     /* A server that closes without close_notify ends the stream too; the
        HTTP layer checks lengths and the caller checks the hash. */
+    if (r <= 0) diag_tls_err = r;
     if (r == MBEDTLS_ERR_SSL_PEER_CLOSE_NOTIFY || r == 0) return 0;
     return r < 0 ? -1 : r;
 }
