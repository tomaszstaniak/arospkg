FAILAT 1000
Copy RAM:rxt/apkg-diag RAM:apkg-diag
Protect RAM:apkg-diag +e
Delete SYS:Dg#? ALL FORCE QUIET
RAM:apkg-diag --root SYS:Dg0 update >RESULTS:dg1-update.txt
MakeDir SYS:Dg1
MakeDir SYS:Dg1/db
Copy SYS:Dg0/db/index.json SYS:Dg1/db/index.json
MakeDir SYS:Dg2
MakeDir SYS:Dg2/db
Copy SYS:Dg0/db/index.json SYS:Dg2/db/index.json
MakeDir SYS:Dg3
MakeDir SYS:Dg3/db
Copy SYS:Dg0/db/index.json SYS:Dg3/db/index.json
MakeDir SYS:Dg4
MakeDir SYS:Dg4/db
Copy SYS:Dg0/db/index.json SYS:Dg4/db/index.json
MakeDir SYS:Dg5
MakeDir SYS:Dg5/db
Copy SYS:Dg0/db/index.json SYS:Dg5/db/index.json
MakeDir SYS:Dg6
MakeDir SYS:Dg6/db
Copy SYS:Dg0/db/index.json SYS:Dg6/db/index.json
Date >RESULTS:dg1-t0.txt
RAM:apkg-diag --root SYS:Dg1 --slow 200 install micropolis >RESULTS:dg1-slow200-a.txt
Echo "rc=$RC" >>RESULTS:dg1-slow200-a.txt
Date >>RESULTS:dg1-t0.txt
RAM:apkg-diag --root SYS:Dg2 --slow 200 install micropolis >RESULTS:dg1-slow200-b.txt
Echo "rc=$RC" >>RESULTS:dg1-slow200-b.txt
Date >>RESULTS:dg1-t0.txt
RAM:apkg-diag --root SYS:Dg3 install micropolis >RESULTS:dg1-noslow.txt
Echo "rc=$RC" >>RESULTS:dg1-noslow.txt
Date >>RESULTS:dg1-t0.txt
RAM:apkg-diag --root SYS:Dg4 --slow 50 install micropolis >RESULTS:dg1-slow50.txt
Echo "rc=$RC" >>RESULTS:dg1-slow50.txt
Date >>RESULTS:dg1-t0.txt
RAM:apkg-diag --root SYS:Dg5 --slow 200 install gmore >RESULTS:dg1-gmore-slow200.txt
Echo "rc=$RC" >>RESULTS:dg1-gmore-slow200.txt
Date >>RESULTS:dg1-t0.txt
Echo "REDIR DONE" >RESULTS:dg1-redir-done.txt
