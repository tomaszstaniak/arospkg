FAILAT 1000
C:UnZip >NIL: RAM:rxt/rc.zip -d RAM:rc
CD RAM:rc/arospkg-0.3.1-rc1.x86_64-aros-v11
Protect apkg +e
apkg --version >RESULTS:x8664arosv11-version.txt
List RAM:rc/arospkg-0.3.1-rc1.x86_64-aros-v11 >RESULTS:x8664arosv11-files.txt
apkg --root RAM:RcTest update >RESULTS:x8664arosv11-net.txt
apkg --root RAM:RcTest  search >>RESULTS:x8664arosv11-net.txt
apkg --root RAM:RcTest  show zaphod >>RESULTS:x8664arosv11-net.txt
apkg --root RAM:RcTest  install zaphod >>RESULTS:x8664arosv11-net.txt
apkg --root RAM:RcTest list >>RESULTS:x8664arosv11-net.txt
CD RAM:RcTest/zaphod
Run >NIL: <NIL: ZapHod
Wait 12
Status >>RESULTS:x8664arosv11-start.txt
CD RAM:
CD RAM:rc/arospkg-0.3.1-rc1.x86_64-aros-v11
apkg --root RAM:RcTest  remove zaphod >>RESULTS:x8664arosv11-net.txt
apkg --root RAM:RcTest list >>RESULTS:x8664arosv11-net.txt
